// Ex1 --- Δεδομένου ενός πίνακα αριθμών, χρησιμοποιήστε τη συνάρτηση map για να δημιουργήσετε έναν νέο πίνακα όπου κάθε αριθμός διπλασιάζεται.

const arr = [1, 3, 6, 9]

const doubledArray = arr.map(num => num * 2)

console.log(doubledArray)


// Ex2 --- Δεδομένου ενός πίνακα αριθμών, χρησιμοποιήστε τη συνάρτηση filter για να δημιουργήσετε έναν νέο πίνακα που περιλαμβάνει μόνο τους ζυγούς αριθμούς

const arr2 = [5, 3, 2, 12]

const evenArray = arr2.filter(num => num % 2 === 0)
console.log(evenArray)


// Ex3 --- Δεδομένου ενός πίνακα αριθμών, χρησιμοποιήστε τη συνάρτηση some για να ελέγξετε εάν τουλάχιστον ένας αριθμός είναι θετικός

const arr3 = [0, -5, -8, 10, 6]

const positiveNumbers = arr3.some(num => num > 0)
console.log(positiveNumbers)


// Ex4 --- Δεδομένου ενός πίνακα αριθμών, χρησιμοποιήστε τη συνάρτηση every για να ελέγξετε εάν όλοι οι αριθμοί είναι θετικοί

const arr4 = [7, 4, -2, 42, 6]

const allPositiveNumbers = arr4.every(num => num > 0)
console.log(allPositiveNumbers)


// Ex2.1 Δεδομένου ενός πίνακα αντικειμένων, χρησιμοποιήστε τη συνάρτηση filter για να δημιουργήσετε έναν νέο πίνακα που περιλαμβάνει μόνο χρήστες κάτω των 30 ετών

const people = [{ name: 'Alice', age: 30 },
{ name: 'Bod', age: 25 },
{ name: 'Charlie', age: 35 }
];

const underThirty = people.filter(person => person.age < 30)
console.log(underThirty)

// Ex2.2 Στη συνέχεια χρησιμοποιήστε τη συνάρτηση map για να δημιουργήσετε έναν νέο πίνακα που περιέχει μόνο τα ονόματα

const onlyNamesArray = people.map(person => person.name)
console.log(onlyNamesArray)